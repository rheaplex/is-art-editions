      "contents": "{\n    { }\n    function abi_encode_tuple_t_bytes6__to_t_bytes6__fromStack_reversed(headStart, value0) -> tail\n    {\n        tail := add(headStart, 32)\n        mstore(headStart, and(value0, shl(208, 0xffffffffffff)))\n    }\n}",
